{
  "name": "escape-bincov",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "逃离滨科夫：单人像素撤离生存游戏",
  "scripts": {
    "checks": "node scripts/checks.mjs",
    "architecture": "node scripts/architecture.mjs",
    "check:ci": "node --test scripts/ci/*.test.mjs",
    "check:perk-ui": "node scripts/perk-ui-browser.mjs",
    "diagnose:coast-heap": "node scripts/coast-sample-heap.mjs",
    "diagnose:coast-owners": "node scripts/sol-r6-heap.mjs",
    "diagnose:f20": "node scripts/astra-r7-f20.mjs",
    "dev": "node scripts/build.mjs --serve",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "enemy:catalog": "node --import tsx scripts/enemy-catalog.ts",
    "bench:enemy": "node --import tsx scripts/enemy-benchmark.ts",
    "test:enemy": "node --import tsx scripts/enemy-browser-test.mjs",
    "test:enemy-720": "node --import tsx scripts/enemy-browser-test.mjs --shard=enemy-720",
    "test:enemy-1080": "node --import tsx scripts/enemy-browser-test.mjs --shard=enemy-1080",
    "test:enemy-touch": "node --import tsx scripts/enemy-browser-test.mjs --shard=enemy-touch",
    "test:browser": "node scripts/browser-test.mjs",
    "test:desktop-input": "node scripts/desktop-input-test.mjs",
    "test:shooting": "node scripts/shooting-test.mjs",
    "test:save-browser": "node scripts/save-browser-test.mjs",
    "test:play": "node --import tsx scripts/natural-play.mjs",
    "package": "pnpm build && node scripts/package.mjs",
    "test:portable": "node scripts/portable-test.mjs",
    "test:ui": "node scripts/ui-review.mjs",
    "test:mobile": "node scripts/mobile-test.mjs",
    "test:mobile-ux": "node --import tsx scripts/mobile-ux-test.mjs",
    "test:title": "node scripts/title-review.mjs",
    "test:opening": "node --import tsx scripts/opening-test.mjs",
    "title:art": "node --import tsx scripts/title-art/generate.ts",
    "title:evidence": "node scripts/title-evidence.mjs",
    "test:loot": "node scripts/loot-browser-test.mjs",
    "test:loot-target": "node --import tsx scripts/loot-target-test.mjs",
    "test:qol": "node scripts/qol-test.mjs",
    "test:hideout": "node scripts/hideout-browser-test.mjs",
    "test:station": "node --import tsx scripts/station-browser-test.mjs",
    "test:station-hands": "node --import tsx scripts/station-browser-test.mjs --only=H15 --out=test-results/station-hands",
    "test:station-tier1": "node --import tsx scripts/station-tier1-test.mjs",
    "test:station-tier2": "node --import tsx scripts/station-tier2-test.mjs",
    "test:station-relief": "node scripts/station-relief-test.mjs",
    "test:station-reset": "node scripts/station-reset-test.mjs",
    "test:station-capability": "node --import tsx scripts/station-capability-listeners.mjs",
    "test:shop-drag": "node scripts/shop-drag-test.mjs",
    "test:shop-feedback": "node scripts/shop-feedback-test.mjs",
    "test:asset-load": "node scripts/asset-load-test.mjs",
    "test:hud-release": "node scripts/hud-release-test.mjs",
    "test:coast-render-targets": "node scripts/coast-render-target-test.mjs",
    "test:coast-animation": "node scripts/coast-sample-test.mjs --group=animation",
    "test:coast-sample": "node scripts/coast-sample-test.mjs",
    "test:qol-expansion": "node scripts/qol-expansion-test.mjs",
    "test:expansion": "node scripts/expansion-browser-test.mjs",
    "test:expansion-benchmark": "node --import tsx scripts/expansion-benchmark.mjs",
    "test:buildings": "node scripts/building-browser-test.mjs",
    "test:systems": "node --import tsx scripts/systems-browser-test.mjs",
    "test:layered-play": "node --import tsx scripts/layered-play.mjs",
    "test:mall-passages": "node --import tsx scripts/mall-passages.mjs",
    "test:mall-landing": "node --import tsx scripts/mall-landing.mjs",
    "test:mall-sample": "node scripts/mall-sample-test.mjs",
    "test:raid-default": "node scripts/raid-default-test.mjs",
    "test:range": "node scripts/range-test.mjs",
    "test:gunsmith-bench": "node --import tsx scripts/gunsmith-bench-test.mjs",
    "test:gunsmith-flow": "node scripts/gunsmith-flow-test.mjs",
    "test:art": "node --import tsx scripts/art-review.mjs",
    "test:tactical": "node --import tsx scripts/tactical-review.mjs",
    "test:title-water": "node --import tsx scripts/title-water-review.mjs",
    "test:issue26-station": "node --import tsx scripts/issue26-station-test.mjs",
    "test:issue26-inventory": "node scripts/issue26-raid-inventory-test.mjs",
    "test:issue26-spatial": "node scripts/issue26-spatial-test.mjs"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "playwright": "^1.55.0"
  },
  "packageManager": "pnpm@11.19.0"
}
